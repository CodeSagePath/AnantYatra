{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anantyatra.local/schemas/v1/feedback-taxonomy.schema.json",
  "title": "AnantYatra Feedback Taxonomy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taxonomyId", "version", "categories"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taxonomyId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "label", "enabled"],
        "properties": {
          "categoryId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
