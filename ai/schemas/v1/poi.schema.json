{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anantyatra.local/schemas/v1/poi.schema.json",
  "title": "AnantYatra Point of Interest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "poiId", "displayName", "category", "location", "quality", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "poiId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Real place names are retained for traveller recommendations." },
    "category": { "enum": ["attraction", "restaurant", "hotel", "fuel_station", "restroom", "parking", "repair", "hospital", "viewpoint", "convenience_store", "other"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "facilities": { "type": "object", "additionalProperties": { "enum": ["available", "unavailable", "unknown"] } },
    "openingHours": { "type": ["string", "null"], "maxLength": 500 },
    "priceRange": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["currency", "minimum", "maximum"],
      "properties": {
        "currency": { "const": "INR" },
        "minimum": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "confidence", "updatedAt"],
      "properties": {
        "state": { "enum": ["unverified", "source_confirmed", "user_confirmed", "disputed", "stale"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRecordId", "fact", "observedAt"],
        "properties": {
          "sourceRecordId": { "type": "string", "minLength": 1 },
          "fact": { "type": "string", "minLength": 1, "maxLength": 500 },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
