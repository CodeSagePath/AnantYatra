{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anantyatra.local/schemas/v1/model-release.schema.json",
  "title": "AnantYatra Model Release Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "baseModelId", "baseRevision", "adapterPath", "adapterSha256", "datasetManifestPath", "datasetManifestSha256", "evaluationSuiteManifestPath", "evaluationSuiteSha256", "evaluationReportPath", "evaluationReportSha256", "metrics", "hardGates", "humanReview", "state", "promotedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "releaseId": { "type": "string", "minLength": 1 },
    "baseModelId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 1 },
    "adapterPath": { "type": "string", "minLength": 1 },
    "adapterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "datasetManifestPath": { "type": "string", "minLength": 1 },
    "datasetManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationSuiteManifestPath": { "type": "string", "minLength": 1 },
    "evaluationSuiteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationReportPath": { "type": "string", "minLength": 1 },
    "evaluationReportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioPassRate", "p95LatencyMs"],
      "properties": {
        "scenarioPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95LatencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "hardGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noInventedPoiIds", "allEvidenceGrounded", "allRouteLegsValidated", "allSourcesApproved", "noWithdrawnConsent"],
      "properties": {
        "noInventedPoiIds": { "type": "boolean" },
        "allEvidenceGrounded": { "type": "boolean" },
        "allRouteLegsValidated": { "type": "boolean" },
        "allSourcesApproved": { "type": "boolean" },
        "noWithdrawnConsent": { "type": "boolean" }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewerToken", "reviewedAt"],
      "properties": {
        "decision": { "enum": ["approved", "rejected"] },
        "reviewerToken": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "state": { "enum": ["candidate", "active", "rollback_available", "retired"] },
    "promotedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
