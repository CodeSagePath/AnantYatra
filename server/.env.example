# Server Configuration
PORT=5000

# Database Connection (Dedicated ./db Directory)
DATABASE_URL="file:./db/file.db"

# JWT Secret Key for Authentication
JWT_SECRET="your_super_secret_key_change_this"

# Valhalla Routing Engine Service (Port mapped in Docker)
ROUTING_HOST="http://localhost:5005"
ROUTING_ENGINE_VERSION="3.5.1"
ROUTING_SNAPSHOT_ID="osmfr-karnataka-20261017"
AI_POI_DATA_PATH="../ai/models/datasets/processed/karnataka-2026-10-17/pois.jsonl"
AI_SOURCE_REGISTER_PATH="../ai/data/source-register.jsonl"
LLAMA_BASE_URL="http://10.50.0.1:8080"
# Use the exact model id returned by GET ${LLAMA_BASE_URL}/v1/models.
LLAMA_MODEL="/path/to/Falcon-H1-1.5B-Instruct-Q4_K_M.gguf"

# Enable only when the ODbL source review and data offer are release-ready.
OSM_DATA_OFFER_ENABLED="false"
OSM_DATA_OFFER_BUNDLE=""
\n# Comma-separated list of emails that will automatically be granted ADMIN access on registration\nADMIN_EMAILS=admin@example.com,owner@example.com
